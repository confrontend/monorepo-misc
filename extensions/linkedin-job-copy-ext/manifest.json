{
  "manifest_version": 3,
  "name": "LinkedIn Job Copier",
  "version": "1.0.6",
  "description": "Save LinkedIn job descriptions and move through a search list with one click.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open LinkedIn Job Copier",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [{
    "matches": [
      "https://www.linkedin.com/jobs/*",
      "https://*.linkedin.com/jobs/*",
      "http://www.linkedin.com/jobs/*",
      "http://*.linkedin.com/jobs/*"
    ],
    "js": ["decision-contract.js", "bookleet.js"],
    "run_at": "document_idle"
  }],
  "permissions": ["clipboardWrite", "scripting"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://*.linkedin.com/*"
  ]
}
