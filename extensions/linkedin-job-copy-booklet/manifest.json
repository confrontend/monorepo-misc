{
  "manifest_version": 3,
  "name": "LinkedIn Job Copier",
  "version": "1.0.0",
  "description": "Save LinkedIn job descriptions and move through a search list with one click.",
  "content_scripts": [{
    "matches": ["https://*.linkedin.com/jobs/*"],
    "js": ["bookleet.js"],
    "run_at": "document_idle"
  }],
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://*.linkedin.com/*"]
}
