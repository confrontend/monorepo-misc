# Solana RPC provider used by the experimental benchmark.
# The populated .env file is ignored and must never be committed.
SOLANA_RPC_PROVIDER=helius
HELIUS_API_KEY=d53645a1-a7ee-480b-9cf2-11434e28a8c7
# Optional: use a provider-neutral full endpoint instead of HELIUS_API_KEY.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=PASTE_HELIUS_API_KEY_HERE
