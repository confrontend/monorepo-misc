{
  "name": "vantage-crypto-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Append-only local data collection for Solana token cohorts and GMGN signals.",
  "bin": {
    "crypto-research": "dist/src/scripts/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config vite.config.ts",
    "dev": "concurrently -k -n api,ui,graph -c green,cyan,magenta \"npm run dev:api\" \"npm run dev:ui\" \"npm run graph:watch\"",
    "predev": "prettier --write package.json src ui extension",
    "dev:api": "tsx watch --env-file-if-exists=.env src/scripts/server.ts",
    "dev:ui": "vite --config vite.config.ts --host",
    "graph:watch": "uv --cache-dir .uv-cache-watch tool run --from graphifyy --with watchdog graphify watch .",
    "lint": "eslint .",
    "lint:report": "node scripts/eslint-report.mjs",
    "lint:fix": "eslint . --fix --format compact",
    "code:unused": "knip --reporter compact",
    "code:duplicates": "jscpd src ui extension tests scripts --config .jscpd.json",
    "code:check": "npm run lint && npm run code:unused && npm run code:duplicates",
    "arch:check": "depcruise --config .dependency-cruiser.cjs --ts-config tsconfig.json src ui extension",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "import-dune": "npm run build --silent && node dist/src/scripts/cli.js import-dune",
    "db-stats": "npm run build:server --silent && node dist/src/scripts/cli.js db-stats",
    "start": "npm run build && node --env-file-if-exists=.env dist/src/scripts/server.js"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gmgn-cli": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.5"
  }
}
