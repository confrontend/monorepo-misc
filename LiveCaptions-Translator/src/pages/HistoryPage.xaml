<Page
    x:Class="LiveCaptionsTranslator.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HistoryPage"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Left">

                <ui:Button
                    x:Name="PageDown"
                    Appearance="Transparent"
                    Click="PageDown_click"
                    Icon="{ui:SymbolIcon chevronLeft12, Filled=False}"/>

                <ui:TextBlock
                    x:Name="PageNumber"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Text="1/1"/>

                <ui:Button
                    x:Name="PageUp"
                    Appearance="Transparent"
                    Click="PageUp_click"
                    Icon="{ui:SymbolIcon chevronRight12, Filled=False}"/>

                <ComboBox
                    x:Name="HistoryMaxRow"
                    Margin="5,0,0,0"
                    SelectedIndex="1">

                    <ComboBoxItem Content="20/page"
                            Tag="20"/>
                    <ComboBoxItem Content="30/page"
                            Tag="30"/>
                    <ComboBoxItem Content="50/page"
                            Tag="50"/>
                    <ComboBoxItem Content="100/page"
                            Tag="100"/>

                </ComboBox>

                <ui:AutoSuggestBox
                    x:Name="HistorySearchBox"
                    MinWidth="200"
                    Margin="5,0,0,0"
                    PlaceholderText="Search"
                    QuerySubmitted="HistorySearchBox_QuerySubmitted"
                    TextChanged="HistorySearchBox_TextChanged"/>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <ui:Button
                    x:Name="Export"
                    Appearance="Transparent"
                    Click="Export_click"
                    Icon="{ui:SymbolIcon ArrowDown12, Filled=False}"/>

                <ui:Button
                    x:Name="Delete"
                    Margin="5,0,0,0"
                    Appearance="Transparent"
                    Click="Delete_click"
                    Icon="{ui:SymbolIcon Delete12, Filled=False}"/>

                <ui:Button
                    x:Name="Refresh"
                    Margin="5,0,0,0"
                    Appearance="Transparent"
                    Click="Refresh_click"
                    Icon="{ui:SymbolIcon ArrowClockwise12, Filled=False}"/>

            </StackPanel>

        </Grid>

        <!-- History -->

        <DataGrid
            x:Name="HistoryDataGrid"
            Grid.Row="1"
            Margin="0,12,20,0"
            AutoGenerateColumns="False"
            BorderThickness="0"
            HeadersVisibility="None"
            GridLinesVisibility="None"
            Background="Transparent"
            RowBackground="Transparent"
            IsReadOnly="True">

            <DataGrid.Resources>

                <Style TargetType="DataGridRow">
                    <Setter Property="Margin"
                            Value="0,0,0,12"/>
                    <Setter Property="Background"
                            Value="Transparent"/>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTemplateColumn Width="*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Border
                                x:Name="CellBorder"
                                Padding="12"
                                CornerRadius="8"
                                Background="#0FFFFFFF"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonDown="Cell_MouseLeftButtonDown">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- image -->

                                    <Border
                                        Width="60"
                                        Height="60"
                                        CornerRadius="6"
                                        ClipToBounds="True">

                                        <Image
                                            Stretch="UniformToFill"
                                            Source="https://picsum.photos/100"/>

                                    </Border>

                                    <!-- text -->

                                    <TextBlock
                                        x:Name="CellTextBlock"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        FontSize="12"
                                        Height="36"
                                        LineHeight="18"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="#D8FFFFFF">

                                        <Run Text="{Binding ContextText}"/>

                                        <Run Text="{Binding SourceText}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsLatest}"
                                                            Value="True">

                                                            <Setter
                                                                Property="FontWeight"
                                                                Value="Bold"/>

                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>

                                    </TextBlock>

                                </Grid>

                            </Border>

                            <DataTemplate.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsLatest}"
                                    Value="True">

                                    <Setter
                                        TargetName="CellBorder"
                                        Property="Background"
                                        Value="White"/>

                                    <Setter
                                        TargetName="CellTextBlock"
                                        Property="Foreground"
                                        Value="Black"/>

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Page>